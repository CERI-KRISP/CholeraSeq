/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CERI-KRISP/CholeraSeq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                      = null
    // Alternative to --input: directory/list auto-discovery (from Cholera_genomics
    // integration). Mutually exclusive with --input; --reads_dir/--contigs_dir/
    // --sra_list can be combined with each other. See subworkflows/local/get_input.nf.
    reads_dir                  = null // directory of paired fastq (<id>_R1/_R2.fastq.gz or <id>_1/_2.fastq.gz)
    contigs_dir                = null // directory of pre-assembled genomes (.fasta/.fna/.fa, optionally .gz) - each is aligned to the reference and carried through the downstream analysis
    sra_list                   = null // text file, one SRA/ENA accession (SRR/ERR/DRR) per line - Illumina
    ont_sra_list                = null // text file, one SRA/ENA accession per line - Nanopore. Combinable with sra_list/pacbio_sra_list in one run.
    pacbio_sra_list              = null // text file, one SRA/ENA accession per line - PacBio. Combinable with sra_list/ont_sra_list in one run.
    ont_reads_dir                = null // directory of Nanopore fastq.gz files (single-end; one sample per file). Combinable with the other directory/list flags.
    pacbio_hifi_reads_dir        = null // directory of PacBio HiFi fastq.gz files (single-end; one sample per file). Combinable with pacbio_clr_reads_dir.
    pacbio_clr_reads_dir         = null // directory of PacBio CLR/raw fastq.gz files (single-end; one sample per file). Combinable with pacbio_hifi_reads_dir.
    download_method            = 'sratools' // 'sratools' (default and only implemented method - NCBI-independent of EBI) | 'ftp' (NOT YET IMPLEMENTED, fails fast if selected) | 'aspera' (NOT YET IMPLEMENTED, fails fast if selected)

    // ONT/PacBio long-read support (from Cholera_genomics integration)
    platform                    = 'illumina' // default platform tag for --reads_dir/--sra_list bulk modes: 'illumina' | 'nanopore' | 'pacbio' | 'pacbio_hifi' | 'pacbio_clr' ('pacbio' follows --pacbio_mode). Samplesheet rows (--input) can instead set this per-row via an optional 'platform' column.
    pacbio_mode                 = 'hifi'      // 'hifi' -> Flye --pacbio-hifi | 'raw' -> Flye --pacbio-raw. ONT always uses --nano-raw.
    long_read_min_length        = 1000        // Filtlong --min_length
    long_read_keep_percent      = 90          // Filtlong --keep_percent
    long_read_target_bases      = null        // optional Filtlong --target_bases: cap each long-read sample at this many bases (keeps the best reads). ~100x of a 4 Mb genome = 400000000. null = no cap.
    ref_genbank                = null // Recommended to use GCF_003063785.full.gbk

    // thresholds
    min_trim_quality = 20  //fastq reads mean quality threshold	20	fastp
    min_trim_length = 35 //fastq read minimum trim length	50	fastp
    min_mapping_quality = 20 //minimum mapping quality	20	samtools consensus	samtools --min-MQ
    min_base_quality = 20 //minimum base quality	20	samtools consensus	samtools --min-BQ
    min_site_coverage = 5 //mimimum site coverage	5	samtools consensus + snippy	samtools --min-depth 5; snippy --mincov 5
    min_allele_fraction = 0.75 //minimum fraction supporting allele call	0.75	samtools consensus + snippy	samtools -c 0.75; snippy --minfrac 0.75
    snippy_minqual = 100 // minimum variant call quality (Snippy --minqual) - from Cholera_genomics integration; CholeraSeq had no equivalent before
    max_missing_percentage = 50 // Percentage of missing data allowed in a // sample before it is excluded from the analysis | max_missing_percentage	0.5	seqcleaner, gubbins	max percentage of undefined sites in any consensus fasta sequence
    min_parsimony_coverage	= 0.7	// varcodons.py pi job	minimum site coverage for varcodons to keep site when generating pi output

    // Assembly (SPAdes) - from Cholera_genomics integration
    spades_mode = "careful" // "careful", "isolate", "meta", "rna", or "" for default mode
    spades_cov  = "auto"    // --cov-cutoff value; "auto", "off", or a number

    // AMR/virulence/plasmid screening (ABRicate) - from Cholera_genomics integration
    abricate_minid  = 80 // minimum %identity to report a hit
    abricate_mincov = 80 // minimum %coverage to report a hit


    // Core alignment
    global_core_alignment = null //pre-made alignment	null	concatenate consensus sequences (prior to fastbaps and gubbins)
    cohort_core_alignment = null //pre-made alignment to be concatenated to existing global alignment


    // optional subworkflow
    skip_fastbaps              = true
    skip_clustering            = false
    min_partition_size          = 4  // minimum sequences per FastBAPS cluster required to run Gubbins/RAxML - clusters smaller than this are skipped. NOTE: bumped from 3 to 4 after empirical testing - a real 3-sequence cluster still failed with "TOO FEW SPECIES" under RAxML's --asc-corr=stamatakis mode (this pipeline's GUBBINS ext.args uses --tree-builder raxml), even though Cholera_genomics' own equivalent param defaults to 3. The ascertainment-bias-correction mode apparently needs >3 taxa even though plain RAxML can run on 3.

    // Assembly / typing / AMR subworkflow (from Cholera_genomics integration)
    skip_assembly               = false
    skip_mlst                   = false
    skip_amr                    = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = "CholeraSeq"
    multiqc_logo               = "${projectDir}/assets/CERI_logo_b.png"
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                     = null
    tracedir                   = "${params.outdir}/pipeline_info"
    // Single timestamp shared by the timeline/report/trace/dag files for this run
    // (replaces the old top-level `def trace_timestamp = ...` declaration, which
    // is not allowed under Nextflow's strict config syntax)
    trace_timestamp             = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    // NOTE: these params ARE now documented in nextflow_schema.json (added
    // for nf-core lint compliance), but are deliberately kept in this
    // ignore list too - schema_ignore_params skips *validation*, not
    // documentation, and this pipeline's NfcoreSchema.groovy does not
    // coerce CLI string arguments to a param's declared JSON type (proven:
    // --max_cpus 6 failed with "expected type: Number, found: String").
    // Every boolean param here has been run successfully all day as
    // e.g. `--skip_assembly true` (a string, not a real boolean) - removing
    // them from this list would risk breaking every one of those working
    // invocations with the same class of error, for no real benefit.
    schema_ignore_params       = "skip_clustering,skip_fastbaps,skip_assembly,skip_mlst,skip_amr,min_partition_size,reads_dir,ont_reads_dir,pacbio_hifi_reads_dir,pacbio_clr_reads_dir,contigs_dir,sra_list,ont_sra_list,pacbio_sra_list,download_method,platform,pacbio_mode,long_read_min_length,long_read_keep_percent,long_read_target_bases,cohort_core_alignment,global_core_alignment,min_parsimony_coverage,max_missing_percentage,min_allele_fraction,min_site_coverage,min_base_quality,min_mapping_quality,min_trim_length,min_trim_quality,snippy_minqual,spades_mode,spades_cov,abricate_minid,abricate_mincov,ref_genbank,trace_timestamp"


    // Config options
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    config_profile_name        = null


    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load nf-core custom profiles from different Institutions
// NOTE: try/catch is not supported by Nextflow's strict config syntax (default
// since 26.04), so the safe-load pattern below (per nf-core/tools#3132) is used
// instead. If the file can't be fetched (e.g. offline, or the URL is wrong),
// this silently falls back to /dev/null rather than erroring out.
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load CERI-KRISP/CholeraSeq custom profiles from different institutions.
// Warning: Uncomment only if a pipeline-specific instititutional config already exists on nf-core/configs!
// includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/pipeline/CholeraSeq.config" : "/dev/null"


profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    docker {
        docker.enabled         = true
        //NOTE: This is needed for runGubbins https://github.com/nickjcroucher/gubbins/issues/402#issuecomment-2123563583
        docker.runOptions      = "--shm-size 1g"
        docker.registry        = 'quay.io'
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    podman {
        podman.enabled         = true
        podman.runOptions      = "--shm-size 1g"
        podman.registry        = 'quay.io'
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    shifter {
        shifter.enabled        = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    charliecloud {
        charliecloud.enabled   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    gitpod {
        executor.name          = 'local'
        executor.cpus          = 16
        executor.memory        = 60.GB
    }
    test       { includeConfig 'conf/test.config'      }
    test_full  { includeConfig 'conf/test_full.config' }
    hipergator { includeConfig 'conf/hipergator.config'      }
}



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// NOTE: a standalone `def trace_timestamp = ...` variable declaration is not
// allowed at the top level under Nextflow's strict config syntax (default
// since 26.04) - "Variable declarations cannot be mixed with config statements".
// params.trace_timestamp (set in the params block above) is used instead, so
// all four files below still share one consistent timestamp per run.
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${params.trace_timestamp}.html"
}

manifest {
    name            = 'CERI-KRISP/CholeraSeq'
    author          = """abhi18av"""
    homePage        = 'https://github.com/CERI-KRISP/CholeraSeq'
    description     = """A Nextflow pipeline for Cholera outbreak analysis"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.2'
    version         = '1.2.0'
    doi             = ''
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Cap process resource requests at the values set in params.max_cpus /
// params.max_memory / params.max_time. This replaces the old check_max()
// helper function, which is no longer allowed under Nextflow's strict
// config-file syntax (default since Nextflow 26.04). resourceLimits is
// the native Nextflow replacement introduced in nf-core/tools 3.0.0.
process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]
}
