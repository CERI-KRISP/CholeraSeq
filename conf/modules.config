/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: SAMPLESHEET_CHECK {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: FASTP {
        ext.args = " --cut_right --cut_right_window_size 4 --cut_right_mean_quality ${params.min_trim_quality} -l ${params.min_trim_length} "
    }

    withName: SPADES {
        ext.args = {[
            params.spades_mode ? "--${params.spades_mode}" : '',
            "--cov-cutoff ${params.spades_cov}",
        ].join(' ').trim()}
    }

    withName: ABRICATE_RUN {
        ext.args = "--minid ${params.abricate_minid} --mincov ${params.abricate_mincov}"
    }

    // De novo assembly is per-sample and data-dependent: in a large batch some
    // inputs will simply not assemble (too little yield, amplicon/non-genomic
    // data, a different organism) - Flye then exits 1 ("No contigs were
    // assembled"). With the default strategy ('finish') that one sample used to
    // stop the whole run. Here such a sample is ignored (named in a NOTE and
    // recorded as FAILED in pipeline_info/execution_trace_*.txt) and the rest
    // continue. Resource kills (exit 130-145, 104) are still retried with more
    // resources exactly as in conf/base.config.
    withName: 'FLYE_ONT|FLYE_PACBIO_HIFI|FLYE_PACBIO_CLR' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
    }

    withName: FILTLONG {
        ext.args = {[
            "--min_length ${params.long_read_min_length}",
            "--keep_percent ${params.long_read_keep_percent}",
            params.long_read_target_bases ? "--target_bases ${params.long_read_target_bases}" : '',
        ].join(' ').trim()}
    }

    withName: GUBBINS {
        ext.args = "--filter-percentage ${params.max_missing_percentage} --tree-builder raxml --verbose"
        // Single-threaded on purpose: Gubbins 3.4.x (also 3.4.3 and master) writes GFF records from several
        // threads to one file without a lock, splicing records together (thread-unsafe GFF output).
        cpus = 1
    }


    withName: UTILS_VARCODONS {
        ext.args = "-i -n 2 -d ${params.min_parsimony_coverage}"
        ext.prefix = 'ref_fa.pi'
    }

    withName: UTILS_VARCODONS__REPORT {
        ext.args = "-a "
        ext.prefix = 'ref_gbk.varcodons'
    }


    withName: SNIPPY_RUN {
        ext.args = {[
            "--minfrac ${params.min_allele_fraction}",
            "--mincov ${params.min_site_coverage}",
            "--minqual ${params.snippy_minqual}",
        ].join(' ').trim()}
    }

    withName: SAMTOOLS_CONSENSUS {
        ext.args = {[
            "-a",
            "--mode simple",
            "--min-MQ ${params.min_mapping_quality}",
            "--min-BQ ${params.min_base_quality}",
            "--min-depth ${params.min_site_coverage}",
            "-c ${params.min_allele_fraction}",
            "--show-ins no",
            "--show-del yes",
        ].join(' ').trim()}
    }

    withName: IQTREE {
        ext.args = "-bb 1000 -m MFP+ASC"
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

}

// IQ-TREE on real datasets (ModelFinder + 1000 ultrafast bootstraps) routinely runs past the
// 8 h process_medium default, and a task killed for running over time is not retried.
// Give it 72 h by default; the effective limit is still capped by params.max_time (--max_time).
process {
    withName: IQTREE { time = 72.h }
}
